# Generated by OpenSesame 4.0.13 (Melodramatic Milgram)
set width 1024
set height 768
set title "Flanker task"
set start experiment
set foreground white
set background black

define sequence experiment
	run instructions always
	run block_loop always
	run goodbye always

define sketchpad instructions
	set duration keypress
	draw textline text="Respond to the middle arrow<br />Press any key" x=0 y=0 color=white font_size=24

define loop block_loop
	set repeat 2
	set order random
	set item trial_sequence
	setcycle 0 stim "<<<<<"
	setcycle 0 correct_response left
	setcycle 0 congruency congruent
	setcycle 1 stim "<<><<"
	setcycle 1 correct_response right
	setcycle 1 congruency incongruent
	setcycle 2 stim ">>>>>"
	setcycle 2 correct_response right
	setcycle 2 congruency congruent
	run trial_sequence

define sequence trial_sequence
	run fixation always
	run target always
	run response always
	run feedback_correct "[correct] = 1"
	run logger always

define sketchpad fixation
	set duration 500
	draw fixdot x=0 y=0 color=white

define sketchpad target
	set duration 0
	draw textline text="[stim]" x=0 y=0 color=white font_size=48
	draw rect x=-200 y=-50 w=400 h=100 fill=0 color=gray

define keyboard_response response
	set allowed_responses "left;right"
	set correct_response "[correct_response]"
	set timeout 2000

define feedback feedback_correct
	set duration 300
	draw textline text="Correct!" x=0 y=100 color=green

define logger logger

define inline_script compute
	___run__
	print("hi")
	__end__

define sketchpad goodbye
	set duration 1500
	draw textline text="Thanks!" x=0 y=0

<?xml version="1.0" ?>
<PsychoPy2experiment encoding="utf-8" version="2023.2.3">
  <Settings>
    <Param val="height" valType="str" updates="None" name="Units"/>
    <Param val="[1920, 1080]" valType="list" updates="None" name="Window size (pixels)"/>
    <Param val="True" valType="bool" updates="None" name="Full-screen window"/>
    <Param val="$[-1,-1,-1]" valType="color" updates="None" name="color"/>
    <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
    <Param val="{'participant': 'f&quot;{randint(0, 999999):06.0f}&quot;', 'session': '001'}" valType="code" updates="None" name="Experiment info"/>
    <Param val="stroop" valType="str" updates="None" name="expName"/>
    <Param val="testMonitor" valType="str" updates="None" name="Monitor"/>
  </Settings>
  <Routines>
    <Routine name="instruct">
      <TextComponent name="instrText">
        <Param val="OK. Ready for the real thing?&#10;&#10;Remember, ignore the word itself; press:&#10;Left for red LETTERS&#10;Down for green LETTERS&#10;Right for blue LETTERS&#10;(Esc will quit)&#10;&#10;Press any key to continue" valType="str" updates="constant" name="text"/>
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="0.05" valType="num" updates="constant" name="letterHeight"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
      </TextComponent>
      <KeyboardComponent name="ready">
        <Param val="" valType="list" updates="constant" name="allowedKeys"/>
        <Param val="True" valType="bool" updates="constant" name="forceEndRoutine"/>
        <Param val="last key" valType="str" updates="constant" name="store"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
      </KeyboardComponent>
    </Routine>
    <Routine name="trial">
      <TextComponent name="word">
        <Param val="$text" valType="str" updates="set every repeat" name="text"/>
        <Param val="$letterColor" valType="color" updates="set every repeat" name="color"/>
        <Param val="0.15" valType="num" updates="constant" name="letterHeight"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.5" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
      </TextComponent>
      <PolygonComponent name="fixation">
        <Param val="cross" valType="str" updates="constant" name="shape"/>
        <Param val="(0.05, 0.05)" valType="list" updates="constant" name="size"/>
        <Param val="white" valType="color" updates="constant" name="fillColor"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="0.5" valType="code" updates="constant" name="stopVal"/>
      </PolygonComponent>
      <KeyboardComponent name="resp">
        <Param val="'left','down','right'" valType="list" updates="constant" name="allowedKeys"/>
        <Param val="$corrAns" valType="str" updates="constant" name="correctAns"/>
        <Param val="True" valType="bool" updates="constant" name="storeCorrect"/>
        <Param val="True" valType="bool" updates="constant" name="forceEndRoutine"/>
        <Param val="last key" valType="str" updates="constant" name="store"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.5" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="2" valType="code" updates="constant" name="stopVal"/>
      </KeyboardComponent>
      <ParallelOutComponent name="trigger">
        <Param val="1" valType="code" updates="constant" name="startData"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.5" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="0.01" valType="code" updates="constant" name="stopVal"/>
      </ParallelOutComponent>
    </Routine>
    <Routine name="feedback">
      <CodeComponent name="fbCode">
        <Param val="msg = 'doh!'" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="if resp.corr:&#10;    msg = &quot;Correct! RT=%.3f&quot; % resp.rt&#10;else:&#10;    msg = &quot;Oops! That was wrong&quot;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
      </CodeComponent>
      <TextComponent name="fbText">
        <Param val="$msg" valType="str" updates="set every repeat" name="text"/>
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="0.08" valType="num" updates="constant" name="letterHeight"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="1.0" valType="code" updates="constant" name="stopVal"/>
      </TextComponent>
      <MovieComponent name="clip">
        <Param val="clip.mp4" valType="str" updates="constant" name="movie"/>
      </MovieComponent>
    </Routine>
  </Routines>
  <Flow>
    <Routine name="instruct"/>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditionsFile" updates="None" val="trialTypes.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="2" valType="num"/>
      <Param name="name" updates="None" val="trials" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <Routine name="feedback"/>
    <LoopTerminator name="trials"/>
  </Flow>
</PsychoPy2experiment>
